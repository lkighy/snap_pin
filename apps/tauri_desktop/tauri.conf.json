{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贴图钉",
  "version": "0.1.0",
  "identifier": "dev.snap-pin.app",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "贴图钉",
        "width": 980,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
