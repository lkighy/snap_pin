{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Tauri Desktop",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "tauri_desktop", "--features", "local-ocr-rs"],
        "filter": {
          "name": "tauri_desktop",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}\\third_party\\ocr-rs-2.2.2\\3rd_party\\prebuilt\\mnn-dev-windows-x86_64\\lib;${env:PATH}"
      },
      "preLaunchTask": "ui: ensure dev"
    },
    {
      "name": "Tauri Desktop MVP CLI",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "-p", "tauri_desktop", "--features", "local-ocr-rs"],
        "filter": {
          "name": "tauri_desktop",
          "kind": "bin"
        }
      },
      "args": ["--mvp-cli"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PATH": "${workspaceFolder}\\third_party\\ocr-rs-2.2.2\\3rd_party\\prebuilt\\mnn-dev-windows-x86_64\\lib;${env:PATH}"
      }
    }
  ]
}
